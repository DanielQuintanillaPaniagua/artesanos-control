# ============================================================
# ARTESANOS CONTROL - Variables de entorno
# ============================================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el .env real al repositorio.
# ============================================================

# --- Flask ---
FLASK_SECRET_KEY=tu_clave_secreta_aqui_cambiala_en_produccion
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_APP=run.py

# --- Base de datos ---
# Local (XAMPP):
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:@127.0.0.1/artesanos_control
# Produccion:
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://artesanos:TU_PASSWORD@localhost/artesanos_control

# --- Dominio / Servidor ---
# En produccion, forzar el dominio para evitar Host poisoning.
# En development, dejar vacio o no definir.
# SERVER_NAME=artesanos-control.duckdns.org
# PREFERRED_URL_SCHEME=https

# --- SMTP (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_de_gmail_de_16_caracteres
SMTP_FROM=Artesanos Control <tu_correo@gmail.com>

# --- Google Gemini (Artesanos AI) ---
# NOTA: google-generativeai esta deprecado. Migrar a google-genai en el futuro.
GEMINI_API_KEY=tu_api_key_de_gemini

# --- Rate limiting (opcional) ---
# Si no se define, Flask-Limiter usa almacenamiento en memoria.
# Para produccion con multiples workers, usar Redis:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0